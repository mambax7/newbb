{
    "name": "xoops/newbb",
    "description": "NewBB Forum Module for XOOPS CMS",
    "type": "xoops-module",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "XOOPS Development Team",
            "email": "info@xoops.org"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "XoopsModules\\Newbb\\": "class/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XoopsModules\\Newbb\\Tests\\": "tests/"
        }
    },
    "config": {
        "vendor-dir": "vendor"
    }
}
